#!/command/with-contenv ash
# Real shell script, invoked BY the oneshot `up` file. s6-rc `up` files are
# parsed by execlineb, NOT a shell — quoting/multi-command shell syntax there
# silently misparses (learned 2026-08-17: quoted token arg reached `ip`
# verbatim and broke the whole boot).

# Set the SLAAC interface token BEFORE bringing host0 up (RAs are only
# processed once up), so the v6 address is always <prefix>::a00:503 and the
# UniFi dns-server DHCPv6 option keeps pointing at us across prefix changes.
# Replaces the systemd-networkd Token= drop-in from the old debian container.
ip token set ::10.0.5.3 dev host0

exec ifup -a
