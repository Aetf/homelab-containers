#!/command/with-contenv ash
# Real shell script, invoked BY the oneshot `up` file. s6-rc `up` files are
# parsed by execlineb, NOT a shell — quoting/multi-command shell syntax there
# silently misparses (learned 2026-08-17: quoted token arg reached `ip`
# verbatim and broke the whole boot).
#
# Static network identity, injected by the host's adguard-<instance>.nspawn
# unit via Environment= (PID1 env, readable here through with-contenv — the
# same channel that already carries S6_KILL_GRACETIME):
#   IPV4_CIDR    e.g. 10.0.5.3/24  (alice) / 10.0.5.4/24 (bob)
#   IPV4_GATEWAY e.g. 10.0.5.1
#   IPV6_TOKEN   e.g. ::10.0.5.3   (SLAAC interface token)
# Static beats DHCP here: the UDM's UniFi controller never lists clients on
# the gateway's own bridge, so MAC-keyed reservations can't be managed for
# them, and nspawn derives the veth MAC from the machine name anyway (a
# rename would silently orphan such a reservation). IPv6 was already
# effectively static via the token; this makes v4 match. adguardhome
# depends on this oneshot, so any failure here keeps DNS from starting on a
# wrong address — fail fast and loudly.

fail() { echo "net-setup: $1" >&2; exit 1; }

[ -n "${IPV4_CIDR}" ]    || fail "IPV4_CIDR is not set (expected from the .nspawn unit Environment=)"
[ -n "${IPV4_GATEWAY}" ] || fail "IPV4_GATEWAY is not set (expected from the .nspawn unit Environment=)"
[ -n "${IPV6_TOKEN}" ]   || fail "IPV6_TOKEN is not set (expected from the .nspawn unit Environment=)"

ip link set lo up || fail "bringing up lo failed"

# Set the SLAAC token BEFORE host0 comes up (RAs are only processed once up),
# so the v6 address is always <prefix>::<token> and the UniFi dns-server
# DHCPv6 option keeps pointing at us across prefix changes.
ip token set "${IPV6_TOKEN}" dev host0 || fail "setting IPv6 token failed"

# `replace` keeps this idempotent if the oneshot is ever re-run.
ip addr replace "${IPV4_CIDR}" dev host0 || fail "assigning ${IPV4_CIDR} failed"
ip link set host0 up || fail "bringing up host0 failed"
ip route replace default via "${IPV4_GATEWAY}" || fail "installing default route failed"
