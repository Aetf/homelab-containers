# Variables (Override these via command line: just deploy host=root@1.2.3.4)
host := "gw"
machine := "adguard"
remote_base := "/data/custom/machines"
local_tar := "build/rootfs.tar"
# Canonical values live in ../versions.env, exported by the top-level Justfile;
# defaults here only serve direct standalone invocation.
alpine_version := env_var_or_default("ALPINE_VERSION", "3.23.0")
s6_version := env_var_or_default("S6_OVERLAY_VERSION", "3.2.2.0")
# AdGuardHome release pin (target-specific, not in versions.env). Upgrade =
# bump, `just deploy adguard` — replaces the in-place web-UI updater flow.
adguard_version := "v0.107.78"

# Default to building the image
default: build

# 1. Build the local rootfs tarball.
# NOT `podman build --output type=tar`: with warm layer cache it silently
# emits tars missing whole layers' content, incl. every symlink (bitten
# 2026-08-18 on rpi-host). create+export flattens the actual image.
build:
    @echo "Building rootfs for {{machine}}..."
    mkdir -p build
    podman build --arch aarch64 -q \
        --build-arg ALPINE_VERSION={{alpine_version}} \
        --build-arg S6_OVERLAY_VERSION={{s6_version}} \
        --build-arg ADGUARD_VERSION={{adguard_version}} \
        --build-context shared=../shared \
        -t {{machine}}-rootfs .
    c=$(podman create --arch aarch64 {{machine}}-rootfs true) && \
        podman export "$c" > {{local_tar}} && podman rm "$c" >/dev/null
    @echo "Build complete: {{local_tar}}"

# 2. Deploy to remote (Depends on 'build')
# Validate-then-swap, same shape as caddy's: extract to {{machine}}.new,
# --check-config against a copy of the live yaml with the NEW binary, then
# swap. Previous rootfs kept at {{machine}}.old for instant rollback. This is
# the WHOLE-HOUSE DNS - a validation failure aborts with the old container
# still running untouched.
# The adguard.nspawn unit is owned by ~/.config/gw-config, not deployed here.
deploy: build
    @echo "Deploying to {{host}}..."
    cat {{local_tar}} | ssh {{host}} " \
        echo 'Step 1: Extracting new filesystem...' && \
        rm -rf {{remote_base}}/{{machine}}.new && \
        mkdir -p {{remote_base}}/{{machine}}.new && \
        tar -x -C {{remote_base}}/{{machine}}.new && \
        \
        echo 'Step 2: Validating live config with the new binary...' && \
        mkdir -p {{remote_base}}/{{machine}}.new/data/adguard && \
        cp /data/adguard/AdGuardHome.yaml {{remote_base}}/{{machine}}.new/data/adguard/ && \
        chroot {{remote_base}}/{{machine}}.new /opt/AdGuardHome/AdGuardHome \
            --check-config -c /data/adguard/AdGuardHome.yaml -w /data/adguard && \
        rm -rf {{remote_base}}/{{machine}}.new/data && \
        \
        echo 'Step 3: Swapping (old kept as {{machine}}.old)...' && \
        systemctl stop systemd-nspawn@{{machine}}.service && \
        rm -rf {{remote_base}}/{{machine}}.old && \
        { mv {{remote_base}}/{{machine}} {{remote_base}}/{{machine}}.old 2>/dev/null || true; } && \
        mv {{remote_base}}/{{machine}}.new {{remote_base}}/{{machine}} && \
        ln -sfn {{remote_base}}/{{machine}} /var/lib/machines/{{machine}} && \
        \
        echo 'Step 4: Starting machine...' && \
        systemctl reset-failed systemd-nspawn@{{machine}}.service 2>/dev/null; \
        systemctl start systemd-nspawn@{{machine}}.service && \
        \
        echo 'Step 5: Health check (auto-rollback on failure)...' && \
        ok=; for i in \$(seq 1 15); do \
            nslookup -timeout=2 google.com 10.0.5.3 >/dev/null 2>&1 && { ok=1; echo \"DNS answering (attempt \$i)\"; break; }; \
        done; \
        if [ -z \"\$ok\" ]; then \
            echo 'HEALTH CHECK FAILED - rolling back to {{machine}}.old'; \
            systemctl stop systemd-nspawn@{{machine}}.service; \
            systemctl kill -s SIGKILL systemd-nspawn@{{machine}}.service 2>/dev/null; \
            systemctl reset-failed systemd-nspawn@{{machine}}.service 2>/dev/null; \
            rm -rf {{remote_base}}/{{machine}}.failed && \
            mv {{remote_base}}/{{machine}} {{remote_base}}/{{machine}}.failed && \
            mv {{remote_base}}/{{machine}}.old {{remote_base}}/{{machine}} && \
            systemctl start systemd-nspawn@{{machine}}.service; \
            echo 'Rolled back; failed rootfs kept at {{machine}}.failed'; \
            exit 1; \
        fi \
    "
    @echo "Deployed. Rollback: ssh {{host}}, stop unit, swap {{machine}}.old back, start."

# Clean up local artifacts
clean:
    rm -f {{local_tar}}
