#!/bin/sh

# Kill the readiness bridge ./run left behind. Skipping this leaks a socat per
# restart whenever Caddy crash-loops.
BRIDGE_PIDFILE="/var/run/caddy-notify-bridge.pid"
if [ -r "$BRIDGE_PIDFILE" ]; then
    bridge_pid=$(cat "$BRIDGE_PIDFILE")
    # The pidfile outlives a bridge that already died, so confirm the pid is still
    # this run's socat before signalling it.
    cmdline=$(tr '\0' ' ' < "/proc/$bridge_pid/cmdline" 2>/dev/null)
    case "$cmdline" in
        "socat "*caddy-notify*) kill "$bridge_pid" 2>/dev/null ;;
    esac
    rm -f "$BRIDGE_PIDFILE"
fi

echo "$1" > /run/s6-linux-init-container-results/exitcode
