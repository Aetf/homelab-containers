# Single source of truth for base versions across all targets.
# Routine upgrade = bump here, then `just build <target>` / `just deploy <target>`
# per target, staged rollout (low-risk targets first).
# Containerfile ARG defaults mirror these values for standalone builds; this
# file is canonical.
# renovate: datasource=docker depName=alpine
ALPINE_VERSION=3.23.0
# renovate: datasource=github-releases depName=just-containers/s6-overlay extractVersion=^v(?<version>.+)$
S6_OVERLAY_VERSION=3.2.2.0
